{
  "name": "wholesale-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:ci": "npm ci --ignore-scripts --legacy-peer-deps",
    "audit": "audit-ci --moderate",
    "prebuild": "rm -rf .next",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "npx prisma generate",
    "db:push": "prisma db push",
    "db:push:vercel": "npx prisma db push --skip-generate --accept-data-loss",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.17",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^2.4.3",
    "brace-expansion": "^5.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.487.0",
    "mercadopago": "^3.2.1",
    "next": "^16.2.12",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.10",
    "prisma": "^6.9.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "sharp": "^0.35.3",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^0.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "lodash": "^4.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  }
}
