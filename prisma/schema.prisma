generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(150)
  email        String?   @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  roleId       Int?      @map("role_id")
  active       Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  role  Role? @relation(fields: [roleId], references: [id])
  sales Sale[]

  @@map("users")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  users        User[]
  rolePolicies RolePolicy[]

  @@map("roles")
}

model Policy {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  nameEs    String   @db.VarChar(150) @map("name_es")
  nameEn    String   @db.VarChar(150) @map("name_en")
  module    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  rolePolicies RolePolicy[]

  @@map("policies")
}

model RolePolicy {
  id       Int @id @default(autoincrement())
  roleId   Int @map("role_id")
  policyId Int @map("policy_id")

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([roleId, policyId])
  @@map("role_policies")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         Int       @id @default(autoincrement())
  barcode    String?   @unique @db.VarChar(100)
  name       String    @db.VarChar(255)
  categoryId Int?      @map("category_id")
  cost       Decimal   @default(0) @db.Decimal(12, 2)
  active     Boolean   @default(true)
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")

  category     Category?      @relation(fields: [categoryId], references: [id])
  prices       ProductPrice[]
  stock        Stock[]
  saleItems    SaleItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  taxId        String?   @map("tax_id") @db.VarChar(50)
  address      String?   @db.Text
  phone        String?   @db.VarChar(50)
  creditLimit  Decimal   @default(0) @map("credit_limit") @db.Decimal(12, 2)
  balance      Decimal   @default(0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  sales Sale[]

  @@map("customers")
}

model PriceList {
  id        Int       @id @default(autoincrement())
  nameEs    String    @default("") @db.VarChar(100) @map("name_es")
  nameEn    String    @default("") @db.VarChar(100) @map("name_en")
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  prices ProductPrice[]

  @@map("price_lists")
}

model ProductPrice {
  id          Int    @id @default(autoincrement())
  productId   Int    @map("product_id")
  priceListId Int    @map("price_list_id")
  price       Decimal @db.Decimal(12, 2)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([productId, priceListId])
  @@map("product_prices")
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  warehouse String   @default("main") @db.VarChar(100)
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @default(now()) @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, warehouse])
  @@map("stock")
}

model Sale {
  id            Int      @id @default(autoincrement())
  saleNumber    String   @unique @map("sale_number") @db.VarChar(50)
  customerId    Int?     @map("customer_id")
  userId        Int?     @map("user_id")
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  tax           Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  status        String   @default("completed") @db.VarChar(50)
  delivery      Boolean  @default(false)
  mpOrderId     String?  @map("mp_order_id") @db.VarChar(100)
  mpQrData      String?  @map("mp_qr_data") @db.Text
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  customer   Customer?   @relation(fields: [customerId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  items      SaleItem[]
  payments   Payment[]

  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Payment {
  id        Int      @id @default(autoincrement())
  saleId    Int      @map("sale_id")
  method    String   @db.VarChar(50)
  amount    Decimal  @db.Decimal(12, 2)
  reference String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  movementType String   @map("movement_type") @db.VarChar(50)
  quantity     Decimal  @db.Decimal(12, 3)
  referenceType String? @map("reference_type") @db.VarChar(50)
  referenceId  Int?     @map("reference_id")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  contact   String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)
  notes     String?   @db.Text
  active    Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")

  products           SupplierProduct[]
  priceLists         SupplierPriceList[]
  extractedDocuments ExtractedDocument[]

  @@map("suppliers")
}

model SupplierProduct {
  id         Int      @id @default(autoincrement())
  supplierId Int      @map("supplier_id")
  name       String   @db.VarChar(255)
  unit       String   @default("") @db.VarChar(50)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  supplier      Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  priceListItems SupplierPriceListItem[]

  @@unique([supplierId, name])
  @@map("supplier_products")
}

model SupplierPriceList {
  id               Int       @id @default(autoincrement())
  supplierId       Int       @map("supplier_id")
  effectiveDate    DateTime  @map("effective_date")
  currency         String?   @default("ARS") @db.VarChar(10)
  sourceDocumentId Int?      @map("source_document_id")
  status           String    @default("extracted") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")

  supplier       Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sourceDocument ExtractedDocument?      @relation(fields: [sourceDocumentId], references: [id])
  items          SupplierPriceListItem[]

  @@map("supplier_price_lists")
}

model SupplierPriceListItem {
  id           Int      @id @default(autoincrement())
  priceListId  Int      @map("price_list_id")
  productId    Int      @map("product_id")
  price        Decimal  @default(0) @db.Decimal(12, 2)
  currency     String?  @db.VarChar(10)
  availability String   @default("unknown") @db.VarChar(20)

  priceList SupplierPriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   SupplierProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("supplier_price_list_items")
}

model ExtractedDocument {
  id             Int       @id @default(autoincrement())
  inputType      String    @map("input_type") @db.VarChar(50)
  fileName       String?   @map("file_name") @db.VarChar(255)
  mimeType       String?   @map("mime_type") @db.VarChar(150)
  storagePath    String?   @map("storage_path") @db.Text
  rawText        String    @map("raw_text") @db.Text
  contentHash    String    @map("content_hash") @db.VarChar(64) @unique
  status         String    @default("processed") @db.VarChar(20)
  errorMessage   String?   @map("error_message") @db.Text
  geminiResponse Json?     @map("gemini_response")
  createdAt      DateTime  @default(now()) @map("created_at")

  supplierId Int? @map("supplier_id")

  supplier   Supplier?            @relation(fields: [supplierId], references: [id])
  priceLists SupplierPriceList[]

  @@map("extracted_documents")
}
