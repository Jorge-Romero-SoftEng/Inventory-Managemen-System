# Stop automatic execution of malicious postinstall/preinstall scripts
ignore-scripts=true

# Block untrusted git-source dependencies
allow-git=none

# Reject packages published less than 7 days ago to let the community flag threats
min-release-age=7d
# Enables automatic security vulnerability scans of your project's dependency tree whenever you run npm install
audit=true

# Hides funding and donation request messages from package maintainers during terminal installations to keep output clean.
fund=false

# Forces the creation and enforcement of a package-lock.json file to lock dependencies to exact versions.
package-lock=true